# Set these in Vercel Project Settings > Environment Variables.
SOCIABUZZ_WEBHOOK_TOKEN=replace_with_a_long_random_secret
# Confirm the actual SociaBuzz SHOP auth header before changing this value.
SOCIABUZZ_TOKEN_HEADER=x-webhook-token

# Optional Supabase persistence
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Protect the manual test endpoint
TEST_ENDPOINT_KEY=replace_with_another_long_random_secret
